(def width 640
     height 480)

(make-canvas width height)
 
(style
 (*
  padding 0
  margin 0)
 (body
  background black
  width 100%
  height 100dvh)
 (canvas
  object-fit contain
  background black
  width 100%
  height 100%))
  

(color :red)
(rectangle 0 0 30 30)
(rectangle (- width 30) (- height 30) 30 30)

